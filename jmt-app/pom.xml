<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>jmt</groupId>
        <artifactId>jmt</artifactId>
        <version>latest</version>
    </parent>

    <artifactId>jmt-app</artifactId>

    <!-- Application composition root: entry-point classes (GraphStartScreen, JSIMWizMain,
         JMVAWizard, JabaWizard, Jmt command-line), the maven-shade fat-JAR, and
         GUI smoke tests (JabaGuiTest, MainGuiTest, …).
         Entry points live in this module so that the GUI modules they depend on
         are not forced to declare each other as compile-scope dependencies (which
         would create circular self-references in the parent POM's <dependencies>). -->

    <dependencies>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jsimg-gui</artifactId>
            <version>latest</version>
        </dependency>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jaba-gui</artifactId>
            <version>latest</version>
        </dependency>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jwat-gui</artifactId>
            <version>latest</version>
        </dependency>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jmva-gui</artifactId>
            <version>latest</version>
        </dependency>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jmch-gui</artifactId>
            <version>latest</version>
        </dependency>
        <dependency>
            <groupId>jmt</groupId>
            <artifactId>jmt-jsimw-gui</artifactId>
            <version>latest</version>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>1.3.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.easytesting</groupId>
            <artifactId>fest-swing</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>2.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>JMT-singlejar-${jmt.version}</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>common.startScreen.GraphStartScreen</mainClass>
                                </transformer>
                            </transformers>
                            <dependencyReducedPomLocation>${basedir}/target/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
