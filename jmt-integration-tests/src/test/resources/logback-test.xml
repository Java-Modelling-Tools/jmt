<configuration>
  <!-- stderr: IntegrationTest replaces System.out to silence engine prints -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder><pattern>[%level] %logger{0}%X{model} - %msg%n</pattern></encoder>
  </appender>
  <!-- Override with -Dlogback.level=DEBUG to see per-model start/finish lines. -->
  <root level="${logback.level:-INFO}"><appender-ref ref="CONSOLE"/></root>
</configuration>
