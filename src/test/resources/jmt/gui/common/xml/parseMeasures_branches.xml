<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<archive xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="ParseMeasuresBranches.jsimg" timestamp="Mon Mar 23 00:00:00 CET 2026" xsi:noNamespaceSchemaLocation="Archive.xsd">
    <sim disableStatisticStop="false" logDecimalSeparator="." logDelimiter="," maxSamples="1000000" name="ParseMeasuresBranches" polling="1.0" xsi:noNamespaceSchemaLocation="SIMmodeldefinition.xsd">

        <userClass name="Class1" priority="0" referenceSource="Source1" type="open"/>
        <userClass name="Class2" priority="0" referenceSource="Source1" type="open"/>

        <node name="Source1">
            <section className="RandomSource">
                <parameter array="true" classPath="jmt.engine.NetStrategies.ServiceStrategy" name="ServiceStrategy">
                    <refClass>Class1</refClass>
                    <subParameter classPath="jmt.engine.NetStrategies.ServiceStrategies.ServiceTimeStrategy" name="ServiceTimeStrategy">
                        <subParameter classPath="jmt.engine.random.Exponential" name="Exponential"/>
                        <subParameter classPath="jmt.engine.random.ExponentialPar" name="distrPar">
                            <subParameter classPath="java.lang.Double" name="lambda"><value>1.0</value></subParameter>
                        </subParameter>
                    </subParameter>
                    <refClass>Class2</refClass>
                    <subParameter classPath="jmt.engine.NetStrategies.ServiceStrategies.ServiceTimeStrategy" name="ServiceTimeStrategy">
                        <subParameter classPath="jmt.engine.random.Exponential" name="Exponential"/>
                        <subParameter classPath="jmt.engine.random.ExponentialPar" name="distrPar">
                            <subParameter classPath="java.lang.Double" name="lambda"><value>1.0</value></subParameter>
                        </subParameter>
                    </subParameter>
                </parameter>
            </section>
            <section className="ServiceTunnel"/>
            <section className="Router">
                <parameter array="true" classPath="jmt.engine.NetStrategies.RoutingStrategy" name="RoutingStrategy"/>
            </section>
        </node>

        <node name="QueueForMeasure">
            <section className="Queue">
                <parameter classPath="java.lang.Integer" name="size"><value>-1</value></parameter>
            </section>
            <section className="Server">
                <parameter classPath="java.lang.Integer" name="maxJobs"><value>1</value></parameter>
            </section>
            <section className="Router">
                <parameter array="true" classPath="jmt.engine.NetStrategies.RoutingStrategy" name="RoutingStrategy"/>
            </section>
        </node>

        <node name="TransitionForFX">
            <section className="Enabling"/>
            <section className="Timing">
                <parameter array="true" classPath="java.lang.String" name="modeNames">
                    <subParameter classPath="java.lang.String" name="modeName"><value>ModeA</value></subParameter>
                    <subParameter classPath="java.lang.String" name="modeName"><value>ModeB</value></subParameter>
                </parameter>
            </section>
            <section className="Firing"/>
        </node>

        <node name="Sink1">
            <section className="JobSink"/>
        </node>

        <measure alpha="0.10" name="M_ResponseTime_Station" nodeType="station" precision="0.01" referenceNode="QueueForMeasure" referenceUserClass="Class1" serverType="UnknownType" type="Response Time" verbose="true"/>
        <measure alpha="0.20" name="M_NumberOfCustomers_Region" nodeType="region" precision="0.02" referenceNode="RegionForMeasure" referenceUserClass="Class2" serverType="IgnoredType" type="Number of Customers" verbose="false"/>
        <measure alpha="0.30" name="M_SystemThroughput_Nulls" nodeType="" precision="0.03" referenceNode="" referenceUserClass="" serverType="" type="System Throughput" verbose="true"/>
        <measure alpha="0.40" name="M_FiringThroughput_FX" nodeType="station" precision="0.04" referenceNode="TransitionForFX" referenceUserClass="ModeB" serverType="" type="Firing Throughput" verbose="false"/>
        <measure alpha="0.50" name="M_Utilization_ClassOnly" nodeType="" precision="0.05" referenceNode="" referenceUserClass="Class1" serverType="" type="Utilization" verbose="false"/>

        <connection source="Source1" target="QueueForMeasure"/>
        <connection source="QueueForMeasure" target="TransitionForFX"/>
        <connection source="TransitionForFX" target="Sink1"/>

        <blockingRegion name="RegionForMeasure" type="SJF">
            <regionNode nodeName="QueueForMeasure"/>
            <globalConstraint maxJobs="10"/>
        </blockingRegion>
    </sim>
</archive>
