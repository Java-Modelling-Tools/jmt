<?xml version="1.0" encoding="utf-8"?>
<sim xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" disableStatisticStop="true"
     logDecimalSeparator="."
     logDelimiter=";"
     logPath=""
     logReplaceMode="0"
     maxEvents="-1"
     maxSamples="10000"
     name="model.jsimg"
     polling="1.0"
     seed="23000"
     xsi:noNamespaceSchemaLocation="SIMmodeldefinition.xsd">
   <userClass customers="10" name="Class1" priority="0" referenceSource="Delay"
              softDeadline="0.0"
              type="closed"/>
   <node name="Delay">
      <section className="Queue">
         <parameter classPath="java.lang.Integer" name="size">
            <value>-1</value>
         </parameter>
         <parameter array="true" classPath="java.lang.String" name="dropStrategies">
            <refClass>Class1</refClass>
            <subParameter classPath="java.lang.String" name="dropStrategy">
               <value>waiting queue</value>
            </subParameter>
         </parameter>
         <parameter classPath="jmt.engine.NetStrategies.QueueGetStrategies.FCFSstrategy"
                    name="FCFSstrategy"/>
         <parameter array="true" classPath="jmt.engine.NetStrategies.QueuePutStrategy"
                    name="QueuePutStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.QueuePutStrategies.TailStrategy"
                          name="TailStrategy"/>
         </parameter>
      </section>
      <section className="Delay">
         <parameter array="true" classPath="jmt.engine.NetStrategies.ServiceStrategy"
                    name="ServiceStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.ServiceStrategies.ServiceTimeStrategy"
                          name="ServiceTimeStrategy">
               <subParameter classPath="jmt.engine.random.Exponential" name="Exponential"/>
               <subParameter classPath="jmt.engine.random.ExponentialPar" name="distrPar">
                  <subParameter classPath="java.lang.Double" name="lambda">
                     <value>1.000000000000</value>
                  </subParameter>
               </subParameter>
            </subParameter>
         </parameter>
      </section>
      <section className="Router">
         <parameter array="true" classPath="jmt.engine.NetStrategies.RoutingStrategy"
                    name="RoutingStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.RoutingStrategies.EmpiricalStrategy"
                          name="Probabilities">
               <subParameter array="true" classPath="jmt.engine.random.EmpiricalEntry"
                             name="EmpiricalEntryArray">
                  <subParameter classPath="jmt.engine.random.EmpiricalEntry" name="EmpiricalEntry">
                     <subParameter classPath="java.lang.String" name="stationName">
                        <value>Delay</value>
                     </subParameter>
                     <subParameter classPath="java.lang.Double" name="probability">
                        <value>0.700000000000</value>
                     </subParameter>
                  </subParameter>
                  <subParameter classPath="jmt.engine.random.EmpiricalEntry" name="EmpiricalEntry">
                     <subParameter classPath="java.lang.String" name="stationName">
                        <value>Queue1</value>
                     </subParameter>
                     <subParameter classPath="java.lang.Double" name="probability">
                        <value>0.300000000000</value>
                     </subParameter>
                  </subParameter>
               </subParameter>
            </subParameter>
         </parameter>
      </section>
   </node>
   <node name="Queue1">
      <section className="Queue">
         <parameter classPath="java.lang.Integer" name="size">
            <value>-1</value>
         </parameter>
         <parameter array="true" classPath="java.lang.String" name="dropStrategies">
            <refClass>Class1</refClass>
            <subParameter classPath="java.lang.String" name="dropStrategy">
               <value>waiting queue</value>
            </subParameter>
         </parameter>
         <parameter classPath="jmt.engine.NetStrategies.QueueGetStrategies.FCFSstrategy"
                    name="FCFSstrategy"/>
         <parameter array="true" classPath="jmt.engine.NetStrategies.QueuePutStrategy"
                    name="QueuePutStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.QueuePutStrategies.TailStrategy"
                          name="TailStrategy"/>
         </parameter>
      </section>
      <section className="Server">
         <parameter classPath="java.lang.Integer" name="maxJobs">
            <value>1</value>
         </parameter>
         <parameter array="true" classPath="java.lang.Integer" name="numberOfVisits">
            <refClass>Class1</refClass>
            <subParameter classPath="java.lang.Integer" name="numberOfVisits">
               <value>1</value>
            </subParameter>
         </parameter>
         <parameter array="true" classPath="jmt.engine.NetStrategies.ServiceStrategy"
                    name="ServiceStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.ServiceStrategies.ServiceTimeStrategy"
                          name="ServiceTimeStrategy">
               <subParameter classPath="jmt.engine.random.Exponential" name="Exponential"/>
               <subParameter classPath="jmt.engine.random.ExponentialPar" name="distrPar">
                  <subParameter classPath="java.lang.Double" name="lambda">
                     <value>0.666666666667</value>
                  </subParameter>
               </subParameter>
            </subParameter>
         </parameter>
      </section>
      <section className="Router">
         <parameter array="true" classPath="jmt.engine.NetStrategies.RoutingStrategy"
                    name="RoutingStrategy">
            <refClass>Class1</refClass>
            <subParameter classPath="jmt.engine.NetStrategies.RoutingStrategies.EmpiricalStrategy"
                          name="Probabilities">
               <subParameter array="true" classPath="jmt.engine.random.EmpiricalEntry"
                             name="EmpiricalEntryArray">
                  <subParameter classPath="jmt.engine.random.EmpiricalEntry" name="EmpiricalEntry">
                     <subParameter classPath="java.lang.String" name="stationName">
                        <value>Delay</value>
                     </subParameter>
                     <subParameter classPath="java.lang.Double" name="probability">
                        <value>1.000000000000</value>
                     </subParameter>
                  </subParameter>
               </subParameter>
            </subParameter>
         </parameter>
      </section>
   </node>
   <measure alpha="0.01" name="Performance_1" nodeType="station" precision="0.03"
            referenceNode="Delay"
            referenceUserClass="Class1"
            type="Number of Customers"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_2" nodeType="station" precision="0.03"
            referenceNode="Queue1"
            referenceUserClass="Class1"
            type="Number of Customers"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_1" nodeType="station" precision="0.03"
            referenceNode="Delay"
            referenceUserClass="Class1"
            type="Utilization"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_2" nodeType="station" precision="0.03"
            referenceNode="Queue1"
            referenceUserClass="Class1"
            type="Utilization"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_1" nodeType="station" precision="0.03"
            referenceNode="Delay"
            referenceUserClass="Class1"
            type="Response Time"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_2" nodeType="station" precision="0.03"
            referenceNode="Queue1"
            referenceUserClass="Class1"
            type="Response Time"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_1" nodeType="station" precision="0.03"
            referenceNode="Delay"
            referenceUserClass="Class1"
            type="Throughput"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_2" nodeType="station" precision="0.03"
            referenceNode="Queue1"
            referenceUserClass="Class1"
            type="Throughput"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_1" nodeType="station" precision="0.03"
            referenceNode="Delay"
            referenceUserClass="Class1"
            type="Arrival Rate"
            verbose="false"/>
   <measure alpha="0.01" name="Performance_2" nodeType="station" precision="0.03"
            referenceNode="Queue1"
            referenceUserClass="Class1"
            type="Arrival Rate"
            verbose="false"/>
   <connection source="Delay" target="Delay"/>
   <connection source="Queue1" target="Delay"/>
   <connection source="Delay" target="Queue1"/>
   <preload>
      <stationPopulations stationName="Delay">
         <classPopulation population="10" refClass="Class1"/>
      </stationPopulations>
      <stationPopulations stationName="Queue1">
         <classPopulation population="0" refClass="Class1"/>
      </stationPopulations>
   </preload>
</sim>